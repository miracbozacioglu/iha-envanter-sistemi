# Kokteki bu dosya YALNIZCA docker-compose'un okudugu degiskenler icindir.
# Uygulamanin gizli bilgileri backend/.env icinde durur (bkz. backend/.env.example).
#
# Kullanmak icin `.env` olarak kopyalayin; hicbirini tanimlamazsaniz
# docker-compose.yml icindeki varsayilanlar gecerli olur.

# Frontend derlenirken bundle'a gomulecek backend adresi.
# TARAYICIDAN erisilebilir olmali; konteyner ici ad (http://backend:3000) calismaz.
VITE_API_URL=http://localhost:3000

# Backend'in kabul edecegi tarayici kaynaklari (virgulle ayrilir).
CORS_ORIGIN=http://localhost:8080,http://localhost:5174,http://localhost:5173
