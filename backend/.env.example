# backend/.env sablonu — bu dosyayi `.env` olarak kopyalayip doldurun.
# Gercek degerleri ASLA versiyon kontrolune eklemeyin.

# Uygulamanin kullandigi baglanti (Supabase transaction-mode pooler, IPv4).
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:6543/postgres?pgbouncer=true"

# Migration'larin kullandigi baglanti (Supabase session-mode pooler).
# `prisma migrate deploy` bu degiskeni okur — prisma.config.ts'e bakin.
DIRECT_URL="postgresql://KULLANICI:SIFRE@HOST:5432/postgres"

# JWT imzalama anahtari. Uretimde uzun ve rastgele bir deger uretin,
# ornegin: openssl rand -base64 48
JWT_SECRET="buraya-uzun-rastgele-bir-anahtar"

# Token gecerlilik suresi (ornek: 15m, 1h, 7d).
JWT_EXPIRES_IN="1d"

# Tarayicidan gelen isteklere izin verilen kaynaklar (virgulle ayrilir).
# Tanimlanmazsa main.ts http://localhost:5174 ve 127.0.0.1:5174'e duser.
# docker-compose bu degiskeni kendisi :8080 icin ayarliyor.
# CORS_ORIGIN="http://localhost:8080"

# --- Seed (backend/prisma/seed.ts) ---
# Ornek yonetici/teknisyen hesaplarinin sifreleri. Kaynak koda gomulu
# degiller; seed bu degiskenler tanimsizsa CALISMAZ. En az 8 karakter.
# Uretimde seed calistirdiysaniz ilk giristen sonra sifreleri degistirin.
SEED_YONETICI_SIFRE="buraya-guclu-bir-sifre"
SEED_TEKNISYEN_SIFRE="buraya-guclu-bir-sifre"
